@model IEnumerable<VentasVG.Models.VentaDetalle>

@{
    ViewData["Title"] = "Detalle de Venta";
}

<h1 class="text-center">Detalle de Venta</h1>

<div class="container mt-4">

    <div class="mb-3">
        <h4>Venta #@Model.FirstOrDefault()?.VentaId</h4>
    </div>

    <table class="table table-striped table-hover border">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Producto</th>
                <th>Cantidad</th>
                <th>Precio Unitario</th>
                <th>Subtotal</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var detalle in Model)
            {
                <tr>
                    <td>@detalle.Id</td>

                    <td>
                        @detalle.Producto?.NombreProducto
                    </td>

                    <td>@detalle.Cantidad</td>

                    <td>
                        @detalle.PrecioUnitario.ToString("C")
                    </td>

                    <td>
                        @((detalle.Cantidad * detalle.PrecioUnitario).ToString("C"))
                    </td>
                </tr>
            }
        </tbody>

        <tfoot>
            <tr class="table-secondary">
                <td colspan="4" class="text-end">
                    <strong>Total:</strong>
                </td>
                <td>
                    <strong>
                        @Model.Sum(x => x.Cantidad * x.PrecioUnitario).ToString("C")
                    </strong>
                </td>
            </tr>
        </tfoot>
    </table>

    <a asp-action="Index" class="btn btn-secondary">
        Regresar
    </a>

</div>
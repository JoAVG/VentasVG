@model VentasVG.Models.ViewModels.NuevoProductoViewModel

@{
    ViewData["Title"] = "Nuevo Producto";
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-6 offset-3 shadow-sm p-4 border rounded">
            <div class="d-flex justify-content-between align-items-center mb-3">
                 <h2 class="text-center"> Agregar Nuevo Producto</h2>
            </div>
            <hr />
            <!--Aqui el formulario dice a donde enviara los datos metodo POST-->
            <form asp-action="Create">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Producto.NombreProducto" class="form-label">Nombre del Producto</label>
                    <input asp-for="Producto.NombreProducto" class="form-control" placeholder="EJ: Torta De Pollo" />
                    <span asp-validation-for="Producto.NombreProducto" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Producto.Precio" class="form-label">Precio del Producto</label>
                    <input asp-for="Producto.Precio" class="form-control" placeholder="EJ: 19.50" />
                    <span asp-validation-for="Producto.Precio" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Producto.CategoriaId" class="form-label">Seleccione Una Categoria</label>

                    <select asp-for="Producto.CategoriaId" class="form-select">
                        <option value="">Seleccione una categoría</option>

                        @foreach (var categoria in Model.Categorias)
                        {
                            <option value="@categoria.Id">
                                @categoria.NombreCategoria
                            </option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label asp-for="Producto.UnidadVentaId" class="form-label">Seleccione Una Unidad De Venta</label>

                    <select asp-for="Producto.UnidadVentaId" class="form-select">
                        <option value="">Seleccione una Unidad de Venta</option>

                        @foreach (var unidadVenta in Model.UnidadVentas)
                        {
                            <option value="@unidadVenta.Id">
                                @unidadVenta.TipoUnidad
                            </option>
                        }
                    </select>
                </div>

                <div class="mb-4">
                    <button type="submit" class="btn btn-success">Agregar Producto</button>
                    <a asp-action="Index" class="btn btn-secondary">Volver Atras</a>
                </div>
            </form>
        </div>
    </div>
    
</div>

@section Scripts {
@{
    await Html.RenderPartialAsync("_ValidationScriptsPartial");
 }
}
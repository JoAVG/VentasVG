@model IEnumerable<VentasVG.Models.Producto>

@{
    ViewData["Title"] = "Productos";
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
<h1 class="text-center">Lista de Productos</h1>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="text-center"> Gestion de Productos</h1>
        <a asp-action="Create" class="btn btn-primary"> Agregar Producto Nuevo</a>
    </div>

    <table class="table table-striped table-hover border">
        <thead class="table-dark">  
            <th>ID</th>
            <th>Nombre Producto</th>
            <th>Precio</th>
            <th>Categoria</th>
            <th>Unidad De Venta</th>
            <th>Acciones</th>
        </thead>

        <tbody>
            @foreach(var producto in Model)
            {
                <tr>
                    <td>@producto.Id</td>
                    <td>@producto.NombreProducto</td>
                    <td>@producto.Precio</td>
                    <td>@producto.Categoria?.NombreCategoria</td>
                    <td>@producto.UnidadVenta?.TipoUnidad</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@producto.Id" class="btn btn-sm btn-warning">
                            Editar
                        </a>
                        <button class="btn btn-danger btn-sm"
                                data-bs-toggle="modal"
                                data-bs-target="#deleteModal"
                                data-id="@producto.Id"
                                data-nombre="@producto.NombreProducto"
                                data-url="@Url.Action("DeleteProducto")">
                            Eliminar
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Sccrip Para envio de datos a modal-->
@section Scripts
{
     <script>
        //Modal para Eliminar Categoria
        document.getElementById('deleteModal')
        .addEventListener('show.bs.modal', function(event) {

            const button = event.relatedTarget;

            const id = button.dataset.id;
            const nombre = button.dataset.nombre;
            const url = button.dataset.url;

            document.getElementById('deleteId').value = id;
            document.getElementById('deleteMessage').textContent =
                `¿Deseas eliminar "${nombre}"?`;

            document.getElementById('deleteForm').action = url;
        });
    </script>
}
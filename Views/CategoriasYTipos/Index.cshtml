@model VentasVG.Models.ViewModels.CategoriaYTipoViewModel

@{
    ViewData["Title"] = "Categorias Y Tipos";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="container mt-4">
    <h1 class="text-center">Lista de Categorias</h1>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="text-center"> Gestion de Categorias</h1>
        <a asp-action="CreateCategoria" class="btn btn-primary"> Agregar Categoria Nueva</a>
    </div>

    <table class="table table-striped table-hover border">
        <thead class="table-dark">
            <th>Id</th>
            <th>Nombre Categoría</th>
            <th>Acciones</th>
        </thead>
        <tbody>
            @foreach (var categoria in Model.Categorias)
            {
                <tr>
                    <td>@categoria.Id</td>
                    <td>@categoria.NombreCategoria</td>
                    <td>
                        <a asp-action="EditCategoria" asp-route-id="@categoria.Id" class="btn btn-sm btn-warning">
                            Editar
                        </a>
                        
                        <button class="btn btn-danger btn-sm"
                                data-bs-toggle="modal"
                                data-bs-target="#deleteModal"
                                data-id="@categoria.Id"
                                data-nombre="@categoria.NombreCategoria"
                                data-url="@Url.Action("DeleteCategoria")">
                            Eliminar
                        </button>

                    </td>                 
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="container mt-4">
    <h1 class="text-center">Lista de Tipos de Unidad para Venta</h1>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="text-center"> Gestion de Tipos de Unidad</h1>
        <a asp-action="CreateUnidadVenta" class="btn btn-primary"> Agregar Tipo de Unidad Nueva</a>
    </div>

    <table class="table table-striped table-hover border">
        <thead class="table-dark">
            <th>Id</th>
            <th>Tipo Unidad</th>
            <th>Acciones</th>
        </thead>
        <tbody>
            
            @foreach (var unidad in Model.UnidadVentas)
            {
                <tr>
                    <td>@unidad.Id</td>
                    <td>@unidad.TipoUnidad</td>
                    <td>
                        <a asp-action="EditUnidadVenta" asp-route-id="@unidad.Id" class="btn btn-sm btn-warning">
                            Editar
                        </a>
                        <button class="btn btn-danger btn-sm"
                                data-bs-toggle="modal"
                                data-bs-target="#deleteModal"
                                data-id="@unidad.Id"
                                data-nombre="@unidad.TipoUnidad"
                                data-url="@Url.Action("DeleteUnidad")">
                            Eliminar
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Sccrip Para envio de datos a modal-->
@section Scripts
{
    <script>
        //Modal para Eliminar Categoria
        document.getElementById('deleteModal')
        .addEventListener('show.bs.modal', function(event) {

            const button = event.relatedTarget;

            const id = button.dataset.id;
            const nombre = button.dataset.nombre;
            const url = button.dataset.url;

            document.getElementById('deleteId').value = id;
            document.getElementById('deleteMessage').textContent =
                `¿Deseas eliminar "${nombre}"?`;

            document.getElementById('deleteForm').action = url;
        });
        
    </script>
}
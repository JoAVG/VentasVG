@model VentasVG.Models.ViewModels.ProductoViewModel

@{
    ViewData["Title"] = "Realizar Venta";
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<h1 class="text-center">Realizar Venta</h1>

<div class="container-fluid mt-4 ">
    <div class="row ">
        <!--Productos-->
        <div class="col-lg-6">
            <div class="card shadow-sm mn-3">
                <div class="card-header bg-dark text-white">
                    <h4 class="mb-0">
                        Productos
                    </h4>
                </div>
                @{
                    foreach (var categoria in Model.Categorias)
                    {
                        <div class="accordion mb-3">

                            <div class="accordion-item">

                                <h2 class="accordion-header">

                                    <button class="accordion-button collapsed"
                                            type="button"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#categoria@(categoria.Id)">

                                        @categoria.NombreCategoria

                                    </button>

                                </h2>

                                <div id="categoria@(categoria.Id)"
                                     class="accordion-collapse collapse">

                                    <div class="accordion-body">

                                        <!-- Productos -->
                                        @{
                                            var ProductosCategoria = Model.Productos.Where(p => p.CategoriaId == categoria.Id).ToList();

                                            foreach (var producto in ProductosCategoria)
                                            {
                                                var unidad = Model.UnidadVentas
                                                .FirstOrDefault(u => u.Id == producto.UnidadVentaId);

                                                <div class="card-body">
                                                    <div class="card mb-3 border-0 shadow-sm">
                                                        <div class="card-body">

                                                            <div class="d-flex justify-content-between">

                                                                <div>

                                                                    <h5 class="fw-bold mb-1">
                                                                        @producto.NombreProducto
                                                                    </h5>

                                                                    <p class="text-muted">
                                                                        @unidad?.TipoUnidad
                                                                    </p>

                                                                </div>

                                                                <h4 class="text-success">
                                                                    $@producto.Precio
                                                                </h4>

                                                            </div>

                                                            <div class="d-flex align-items-center gap-2">

                                                                <button class="btn btn-outline-danger"
                                                                        onclick="restar(@producto.Id)">

                                                                    -

                                                                </button>

                                                                <span class="badge bg-secondary px-3"
                                                                      id="cantidad-@producto.Id">

                                                                    0

                                                                </span>

                                                                <button class="btn btn-outline-success"
                                                                        onclick="sumar(
                                                                    @producto.Id,
                                                                    '@producto.NombreProducto',
                                                                    @producto.Precio
                                                                    )">

                                                                    +

                                                                </button>

                                                            </div>

                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        }

                                    </div>

                                </div>

                            </div>

                        </div>
                    }
                }
            </div>

        </div>   
    </div>
</div>

@section Scripts {

    <script>

        let pedido = {};

        function sumar(id,nombre,precio)
        {
            if(!pedido[id])
            {
                pedido[id] =
                {
                    nombre:nombre,
                    precio:precio,
                    cantidad:0
                };
            }

            pedido[id].cantidad++;

            document.getElementById(
                `cantidad-${id}`
            ).textContent =
                pedido[id].cantidad;

            actualizarPedido();
        }

        function restar(id)
        {
            if(!pedido[id]) return;

            pedido[id].cantidad--;

            if(pedido[id].cantidad <= 0)
            {
                delete pedido[id];
            }

            document.getElementById(
                `cantidad-${id}`
            ).textContent =
                pedido[id]?.cantidad || 0;

            actualizarPedido();
        }

        function actualizarPedido()
        {
            let contenedor =
                document.getElementById("pedidoItems");

            let total = 0;

            contenedor.innerHTML = "";

            for(let id in pedido)
            {
                let item = pedido[id];

                let subtotal =
                    item.precio * item.cantidad;

                total += subtotal;

                contenedor.innerHTML +=
                `
                <div class="d-flex justify-content-between border-bottom py-2">

                    <div>

                        <strong>${item.nombre} </strong>

                        
                        <br>

                        x${item.cantidad}

                    </div>

                    <div>
                        <strong>$${item.precio}</strong>

                        <br>

                        $${subtotal.toFixed(2)}
                    </div>

                </div>
                `;
            }

            document.getElementById("totalPedido")
                .textContent =
                "$" + total.toFixed(2);
        }

    </script>

}